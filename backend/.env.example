# ========================================================
# WhatsQ Business OS - Backend Environment Configuration
# ========================================================

# Django Core Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-50-char-random-key-in-production
ALLOWED_HOSTS=whatsq.qiyambusinesssolutions.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://whatsq.qiyambusinesssolutions.com

# Database (PostgreSQL for production, SQLite for local dev)
DB_ENGINE=postgresql
DB_NAME=whatsq_db
DB_USER=whatsq_user
DB_PASSWORD=whatsq_secure_password_2026
DB_HOST=localhost
DB_PORT=5432

# Meta WhatsApp Cloud API (Graph API v21.0)
# Obtain these from https://developers.facebook.com
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=qiyam_whatsapp_secret_token_2026

# Production SSL & Security Hardening
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
